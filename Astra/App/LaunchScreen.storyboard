<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="ast-la-unc">
    <!-- LaunchMark is the sun and the word flattened onto the background. It is
         flattened on purpose: an image view in a launch storyboard will not draw
         an asset that carries alpha. It lays out and sizes correctly and then
         renders nothing, which is a hard failure to read. Onboarding has no such
         limit and composes LaunchSun and LaunchWord itself, which it needs to,
         because there it sits over a starfield rather than a flat colour.

         The lockup's centre sits at 0.45 of the screen's height, since a group
         centred on the true middle reads low, and 0.9 of the view's own centre
         is that same 0.45. The mark is built with its lockup centred in the
         canvas, so centring the image centres the lockup.

         Onboarding opens on this same arrangement, which is what makes the
         handoff out of the launch screen invisible. See LaunchMark.swift, and
         Tools/make_launch_mark.swift, which prints the offsets both use. -->
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23503"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="ast-sc-ene">
            <objects>
                <viewController id="ast-la-unc" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="ast-vw-root">
                        <rect key="frame" x="0.0" y="0.0" width="402" height="874"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="center" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="ast-vw-mark"/>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="ast-lg-safe"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="ast-vw-mark" firstAttribute="centerX" secondItem="ast-vw-root" secondAttribute="centerX" id="ast-ct-x"/>
                            <constraint firstItem="ast-vw-mark" firstAttribute="centerY" secondItem="ast-vw-root" secondAttribute="centerY" multiplier="0.9" id="ast-ct-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="ast-ph-resp" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchMark" width="299" height="370"/>
        <namedColor name="LaunchBackground">
            <color red="0.039215686274509803" green="0.050980392156862744" blue="0.078431372549019607" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
